# ==============================================================================
# IT Career Partner - Local Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root or configure these variables in
# your execution environment.
#
# SECURITY NOTICE:
# '.env' is excluded by .gitignore and must NEVER be committed to Git.
# Do NOT put real production credentials in this example file.
# ==============================================================================

# MongoDB Connection URI
# Default for local MongoDB daemon (used when running locally):
MONGODB_URI=mongodb://localhost:27017/it_career_partner

# MongoDB Atlas Connection URI (Template only - use your rotated credentials in private .env):
# MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/it_career_partner?retryWrites=true&w=majority

# Active Spring Profile (optional: leave unset for local development, set to 'prod' for production)
# SPRING_PROFILES_ACTIVE=prod

# Server port (optional, defaults to 8080)
# SERVER_PORT=8080
